# Copy this file to ".env" (or ".env.local") to override the multiplayer server URL.
# Leave it unset for local development: the game then talks to http://<your-host>:3001
# (so it also works from a phone on the same Wi-Fi).
#
# For a production build, set it to your deployed server (HTTPS), for example:
# VITE_SERVER_URL=https://typerush-server.onrender.com
VITE_SERVER_URL=

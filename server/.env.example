# Copy to ".env" if you like; the server reads real environment variables (PowerShell: $env:NAME="value").
# Nothing here is required for local development.

# Port to listen on (hosts like Render set this automatically).
PORT=3001

# Comma-separated list of exact web origins allowed to connect (your deployed frontend), no trailing slash.
# Example: CLIENT_ORIGINS=https://typerush.pages.dev,https://typerush.example.com
CLIENT_ORIGINS=

# Set to "production" when deployed. This turns off the "allow localhost / local network" shortcut
# and turns on proxy trust (needed so per-IP limits see the real client address).
NODE_ENV=development

# Optional overrides
# ALLOW_LOCAL_NETWORK=true     # allow http://localhost and 192.168.x.x origins (default: true outside production)
# TRUST_PROXY=true             # trust X-Forwarded-For (default: true in production)
# LEADERBOARD_FILE=data/leaderboard.json   # use "none" to keep the online board in memory only
